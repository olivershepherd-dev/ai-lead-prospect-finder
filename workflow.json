    {
      "parameters": {
        "jsCode": "const places = $('Merge Branches').all().map(i => i.json);\nconst scores = $('Score Lead').all().map(i => i.json.output || {});\nconst search = $('Get Pending Search').first().json;\nconst esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst leads = places.map((p, idx) => ({ p, s: scores[idx] || {} }))\n  .sort((a, b) => (Number(b.s.score) || 0) - (Number(a.s.score) || 0));\nconst top = leads.slice(0, 5);\nlet html = '<h2>Synclo Prospect Finder: ' + esc(search.trade) + ' in ' + esc(search.suburb) + '</h2>';\nhtml += '<p>' + leads.length + ' new leads added to the Leads sheet (status: needs_review). Top ' + top.length + ' by score:</p><ol>';\nfor (const { p, s } of top) {\n  const name = p.displayName ? p.displayName.text : 'Unknown';\n  html += '<li><b>' + esc(name) + '</b> - score ' + esc(s.score) + '/10 (' + esc(s.confidence) + ' confidence)<br>';\n  html += esc(p.formattedAddress) + ' | ' + esc(p.nationalPhoneNumber || 'no phone') + ' | ' + (p.websiteUri ? '<a href=\"' + esc(p.websiteUri) + '\">website</a>' : 'no website') + ' | rating ' + esc(p.rating || 'n/a') + ' (' + esc(p.userRatingCount || 0) + ')<br>';\n  html += '<i>Gaps:</i> ' + esc((s.gaps || []).join('; ')) + '<br>';\n  html += '<i>Offer:</i> ' + esc(s.recommended_offer) + '<br>';\n  html += '<i>Opener:</i> ' + esc(s.opener) + '</li>';\n}\nhtml += '</ol>';\nreturn [{ json: { subject: 'Synclo leads: top ' + top.length + ' ' + (search.trade || '') + ' in ' + (search.suburb || ''), html, total_new: leads.length } }];"
      },
