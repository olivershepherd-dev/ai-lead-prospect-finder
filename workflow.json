    {
      "parameters": {
        "jsCode": "const existing = new Set($('Read Existing Leads').all().map(i => String(i.json.place_id || '').trim()).filter(Boolean));\nconst search = $('Get Pending Search').first().json;\nreturn $('Split Places').all()\n  .filter(i => i.json.id && !existing.has(String(i.json.id)))\n  .map(i => ({ json: { ...i.json, search_trade: search.trade || '', search_suburb: search.suburb || '' } }));"
      },
