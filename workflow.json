    {
      "parameters": {
        "promptType": "define",
        "text": "=Qualify this Melbourne trade business as a sales lead for Synclo.\n\nBusiness: {{ $json.displayName ? $json.displayName.text : \"\" }}\nTrade searched: {{ $json.search_trade }} in {{ $json.search_suburb }}\nAddress: {{ $json.formattedAddress }}\nPhone: {{ $json.nationalPhoneNumber || \"none\" }}\nGoogle rating: {{ $json.rating || \"n/a\" }} from {{ $json.userRatingCount || 0 }} reviews\nWebsite: {{ $json.websiteUri || \"NONE\" }}\nNo website: {{ $json.no_website === true }}\nWebsite reachable: {{ $json.website_reachable }}\nOnline booking: {{ $json.has_booking }}\nLive chat: {{ $json.has_chat }}\nContact form: {{ $json.has_form }}\nMobile ready: {{ $json.mobile_ready }}\nMentions 24/7 or emergency: {{ $json.mentions_24_7 }}\nWebsite text sample: {{ $json.text_sample || \"(none)\" }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a sales analyst for Synclo, a Melbourne agency that helps trade businesses capture more jobs with automation (online booking, missed-call text-back, AI chat, lead follow-up, review requests). Score each business 1-10 on how strong a prospect it is: high scores = busy, well-reviewed businesses with clear gaps Synclo can fix (no booking, no chat, no website, weak mobile experience, 24/7 promise without after-hours capture). Return exactly 3 specific gaps, one recommended Synclo offer, and an opener: a casual, friendly SMS under 50 words from Ollie at Synclo that references something specific about the business. No emojis, no hard sell. Set confidence to low when you have little data (e.g. website unreachable or no reviews)."
            }
          ]
        },
        "batching": {}
      },
