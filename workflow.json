      "id": "fb7b7158-66ec-4b42-80c2-f9200b580fa2",
      "name": "Fetch Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1024,
        224
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const place = $('Has Website?').item.json;\nconst html = typeof $json.data === 'string' ? $json.data : '';\nconst lower = html.toLowerCase();\nconst text = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\nconst has_booking = /book (online|now|a job|a service|an appointment)|online booking|booking|calendly|servicem8|simpro|tradify|housecallpro|acuity|setmore|schedule (a|an|your) (job|appointment|service)/.test(lower);\nconst has_chat = /intercom|drift\\.com|tawk\\.to|livechat|crisp\\.chat|zendesk|hubspot.*(chat|conversations)|tidio|olark|freshchat|messenger|whatsapp|podium|birdeye/.test(lower);\nconst has_form = /<form[\\s>]/.test(lower) || /contact-form|wpcf7|gravityforms|gform|typeform|jotform|formspree|hsforms/.test(lower);\nconst mobile_ready = /<meta[^>]+name=[\"']?viewport/.test(lower);\nconst mentions_24_7 = /24\\s*\\/\\s*7|24-7|24 hours|24hr|after[- ]hours|emergency/.test(lower);\nreturn { json: {\n  ...place,\n  no_website: false,\n  website_reachable: html.length > 0,\n  website_error: $json.error ? String($json.error.message || $json.error) : '',\n  has_booking, has_chat, has_form, mobile_ready, mentions_24_7,\n  text_sample: text.slice(0, 1500)\n} };"
      },
